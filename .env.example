# GLITCHROT Environment Variables

# ---- Model Paths ----
# Path to RandomForest classifier model (trained via train_classifier.py)
MODEL_PATH=rf_image_classifier.joblib

# Path to optimal decision threshold (generated during training)
THRESHOLD_PATH=best_threshold.npy

# ---- API Configuration ----
# Maximum file size in bytes (default: 50MB)
MAX_FILE_SIZE=52428800

# ---- Logging ----
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ---- Server (for local development) ----
# PORT=8000
# HOST=0.0.0.0
